# Port the HTTP + WebSocket server listens on.
PORT=2567

# Supabase project settings -> API -> JWT secret. Used to verify access tokens.
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase project URL and anon key: the room reads profiles with them, using
# the player's own access token so row level security still applies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
